# Neovim config maintenance tasks: just <command>

set shell := ["bash", "-c"]

# Default: list available commands
default:
    @just --list

# Format the Lua tree (requires stylua)
fmt:
    stylua .

# Verify formatting without writing (requires stylua)
check:
    stylua --check .

# Lua line count
count:
    @find lua -name "*.lua" -exec wc -l {} + | tail -1

# Show the slowest startup phases
startup:
    nvim --headless --startuptime /tmp/nvim-startup.log "+qa"
    @sort -k2 -nr /tmp/nvim-startup.log | head -20

# Interactive health check
health:
    nvim "+checkhealth"

# Install/update tree-sitter parsers (requires tree-sitter-cli on $PATH)
parsers:
    nvim --headless "+TSUpdate" +qa

# Remove plugins that are no longer in the spec
clean:
    nvim --headless "+Lazy! clean" +qa

# Install/update plugins from the spec
sync:
    nvim --headless "+Lazy! sync" +qa
